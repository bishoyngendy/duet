{
  "name": "duet",
  "version": "0.1.0",
  "description": "Claude Code × Codex CLI dual-model, spec-driven development orchestrator",
  "type": "module",
  "private": true,
  "bin": {
    "duet": "bin/duet.js"
  },
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/",
    "test:built": "node scripts/build.mjs && DUET_TEST_BUILT=1 node --test test/",
    "check": "node scripts/build.mjs && git diff --exit-code -- plugins/ && node --test test/ && DUET_TEST_BUILT=1 node --test test/",
    "install-local": "sh scripts/install.sh"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bishoyngendy/duet.git"
  },
  "homepage": "https://github.com/bishoyngendy/duet"
}
